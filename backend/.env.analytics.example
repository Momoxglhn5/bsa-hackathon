# Optional configuration, no secrets. No automatic dotenv loading.
# Without ANALYTICS_SNAPSHOT: read the existing Data SQLite/Parquet stores.
# DOMINO_DATA_DIR=/absolute/path/to/data
# Offline synthetic demo (explicit opt-in):
# ANALYTICS_SNAPSHOT=backend/app/fixtures/analytics_demo.json
# ANALYTICS_REPLAY=true
# Optional JSON: {"quotes": [], "risk_observations": [], "forecasts": []}
# ANALYTICS_INPUTS=/absolute/path/to/analytics-inputs.json
