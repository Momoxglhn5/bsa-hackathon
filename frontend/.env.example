# Base URL of the FastAPI data API (backend/). No trailing slash.
VITE_API_BASE_URL=http://localhost:8000
# REAL or DEMO. DEMO requires `python scripts/load_demo_fixture.py` in backend/.
VITE_DATA_MODE=DEMO
# The API has no position list endpoint: the position shown is read by id.
VITE_POSITION_ID=pos_demo_ui_1
