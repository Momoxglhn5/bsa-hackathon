# Dev proxy targets (read by vite.config.ts, never exposed to the browser bundle).
RADAR_API_TARGET=http://127.0.0.1:8000
RADAR_DEMO_API_TARGET=http://127.0.0.1:8001

# Optional absolute API bases for a static build served elsewhere.
# The backend must then allow this frontend origin in CORS.
# VITE_API_BASE=http://127.0.0.1:8000/api/v1
# VITE_DEMO_API_BASE=http://127.0.0.1:8001/api/v1
